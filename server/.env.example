# Sao chép thành file .env (cùng thư mục) rồi điền giá trị. KHÔNG đưa file .env lên GitHub.

# Ứng dụng Lark (Developer Console > ứng dụng của bạn > Credentials & Basic Info)
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=

# Mã của Lark Base: phần sau /base/ trên thanh địa chỉ, ví dụ https://xxx.larksuite.com/base/AbCdEf123?table=...
LARK_BASE_TOKEN=

# Địa chỉ HTTPS công khai của cầu nối này (điện thoại ngoài công trường dùng 4G phải truy cập được)
PUBLIC_URL=https://lark-bridge.raitek.vn

# Trang web của ứng dụng được phép gọi cầu nối (nhiều địa chỉ cách nhau bởi dấu phẩy)
ALLOWED_ORIGINS=https://mtryha11.github.io

# Chuỗi ngẫu nhiên >= 32 ký tự để ký phiên đăng nhập. Tạo bằng: openssl rand -hex 32
SESSION_SECRET=

# Số ngày giữ đăng nhập trên điện thoại
SESSION_DAYS=30

PORT=8787
# 127.0.0.1 = chỉ nhận kết nối từ chính máy này (khuyên dùng khi có Lucky / Nginx / Cloudflare Tunnel đứng trước).
# Dùng 0.0.0.0 khi chạy trong Docker.
HOST=127.0.0.1

# Chỉ đổi khi dùng Feishu (Trung Quốc): https://open.feishu.cn và https://accounts.feishu.cn
# LARK_OPEN_URL=https://open.larksuite.com
# LARK_ACCOUNTS_URL=https://accounts.larksuite.com

# --- Ghi chú bằng giọng nói (tùy chọn) ---
# Để trống STT_API_KEY thì app dùng cách nhận giọng nói của trình duyệt / bàn phím.
# Mặc định dùng ElevenLabs (mô hình Scribe): điền khóa API ElevenLabs vào đây.
STT_API_KEY=
# STT_MODEL=scribe_v3
# STT_KEYTERMS=inverter, string, MC4, ...        (thuật ngữ chuyên ngành, cách nhau bằng dấu phẩy, tối đa 100)
# Dùng Whisper / dịch vụ tương thích OpenAI thay cho ElevenLabs:
# STT_PROVIDER=openai
# STT_MODEL=whisper-1
