#!/bin/sh /etc/rc.common
# Raitek PV Handover – cầu nối Lark, chạy nền trên OpenWrt / iStoreOS (procd).
# Cài:  cp lark-bridge.init /etc/init.d/lark-bridge && chmod +x /etc/init.d/lark-bridge
#       /etc/init.d/lark-bridge enable && /etc/init.d/lark-bridge start
# Log:  logread -e lark -f
START=99
STOP=10
USE_PROCD=1
DIR=/opt/lark-bridge

start_service() {
	procd_open_instance lark-bridge
	procd_set_param command "$(command -v node)" "$DIR/lark-bridge.mjs"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
